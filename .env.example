# One Way Out Portal — environment template
# Copy to .env.local and fill values (never commit .env.local).
#
# Fastest recovery from Vercel (recommended):
#   vercel link --project <vercel-project-slug> --yes
#   vercel env pull .env.local --environment=production --yes
#
# Or: copy .env.local.example .env.local
# Validate: npm run env:check
# Runbook: docs/CREDENTIALS_RECOVERY.md

# --- P0: Supabase (Project Settings → API) ---
# Member welcome/confirm/reset: Supabase Auth + Custom SMTP — docs/SUPABASE_AUTH_EMAIL.md
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (must match Supabase Auth → URL configuration → Site URL)
NEXT_PUBLIC_APP_URL=
# NEXT_PUBLIC_SITE_URL=

# --- P1: Google OAuth ---
# Same Web client ID as Supabase Auth → Providers → Google
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- P1: Twilio WhatsApp OTP ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# TWILIO_WHATSAPP_CONTENT_SID=

# --- P1: Microsoft Graph (one Azure app registration) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
GRAPH_MAIL_SENDER=
# Auth emails (password reset, coach setup). Falls back to GRAPH_MAIL_SENDER if unset.
GRAPH_AUTH_MAIL_SENDER=no-reply@onewayout.co.za
# From display name in inboxes (defaults to OneWayOut)
# GRAPH_MAIL_FROM_NAME=OneWayOut
EMAIL_TRANSPORT=graph

# Coach welcome/setup: smtp or graph → Graph/SMTP via lib/email; supabase → Supabase reset email only
COACH_SETUP_EMAIL_MODE=smtp
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_REPLY_TO=

# Optional SMTP fallback when EMAIL_TRANSPORT=smtp

# Coach / Teams booking
# TEAMS_MEETING_TIMEZONE=Africa/Johannesburg
# TEAMS_MEETING_DURATION_MINUTES=20
# AVAILABILITY_CACHE_TTL_SECONDS=300

# --- P1: OTP tuning ---
# OTP_EXPIRY_MINUTES=5
# OTP_MAX_ATTEMPTS=3

# --- P2: Yoyo gift cards ---
YOYO_BASE_URL=
YOYO_API_ID=
YOYO_API_PASSWORD=

# --- P2: CRM sync ---
CRM_SYNC_ENABLED=true
CRM_BASE_URL=
# CRM_CREATE_CLIENT_URL=

CRM_USERNAME=
CRM_PASSWORD=
# CRM_AUTH_URL=
# CRM_AUTH_PATH=/api-token-auth/
# CRM_API_TOKEN=
# CRM_TOKEN_HEADER=Authorization
# CRM_TOKEN_PREFIX=Token
# CRM_BASIC_AUTH_B64=
# CRM_API_KEY=
# CRM_API_KEY_HEADER=x-api-key
# CRM_AUTH_MODE=
# CRM_USE_TOKEN_AUTH=
# CRM_AUTH_EXTRA_JSON=

CRM_ORGANISATION_ID=
CRM_TITLE_ID=
CRM_CLIENT_TYPE_ID=
# CRM_ORGANISATION_NAME=
# CRM_TITLE_VALUE=Mr
# CRM_CLIENT_TYPE_VALUE=individual

# --- P3: Admin panel allowlist (comma-separated emails) ---
ADMIN_PANEL_EMAILS=

# --- Optional CRM tuning (only if used in production on Vercel) ---
# CRM_CREATE_CLIENT_PATH=
# CRM_CREATE_CLIENT_METHOD=POST
# CRM_UPDATE_CLIENT_METHOD=PATCH
# CRM_DEFAULT_FIELDS_JSON=
# CRM_PAYLOAD_WRAPPER_KEY=
# CRM_PHASE2_SYNC_ENABLED=true
# CRM_PHASE2_STRICT=true
# CRM_INCLUDE_RAW_ONBOARDING_DATA=
# CRM_INCOME_BUDGET_ITEM_MAP_JSON=
# CRM_EXPENSE_BUDGET_ITEM_MAP_JSON=
