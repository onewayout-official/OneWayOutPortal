# One Way Out Portal — local development template
# Copy to .env.local:  copy .env.local.example .env.local  (Windows)
# Or pull from Vercel:  vercel env pull .env.local --environment=production --yes
#
# See .env.example (same variables) and docs/CREDENTIALS_RECOVERY.md

# --- P0: Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=

# --- P1: Google ---
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- P1: Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- P1: Microsoft 365 / Graph ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
GRAPH_MAIL_SENDER=
EMAIL_TRANSPORT=auto

# --- P2: Yoyo ---
YOYO_BASE_URL=
YOYO_API_ID=
YOYO_API_PASSWORD=

# --- P2: CRM ---
CRM_SYNC_ENABLED=true
CRM_BASE_URL=
CRM_USERNAME=
CRM_PASSWORD=
CRM_ORGANISATION_ID=
CRM_TITLE_ID=
CRM_CLIENT_TYPE_ID=

# --- P3: Admin ---
ADMIN_PANEL_EMAILS=
